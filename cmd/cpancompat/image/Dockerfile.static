# The environment of the static build phase (cpancompat static): the
# survey's Debian with the same packages (their development files carry the
# static archives of the C libraries), the Go toolchain gperl build runs,
# and gperl, which builds distributions with gcc (CC) and links programs
# with cgo, fully statically against glibc (GOFLAGS), as the survey's
# unprivileged user. Distributions live in gperl's module directory and Go
# keeps its caches below /opt/go-cache: volumes the run's containers share.
FROM debian:bookworm-slim

COPY packages mysql.sh user.sh /opt/cpancompat/
RUN apt-get update \
 && apt-get install -y --no-install-recommends $(sed 's/#.*//' /opt/cpancompat/packages) \
 && rm -rf /var/lib/apt/lists/*
RUN sh /opt/cpancompat/mysql.sh

# The Go release `gperl install toolchain` pins, checked against the hash
# gperl records for it (internal/gperl/install.go).
ARG GO_ARCH
RUN case "$GO_ARCH" in \
      arm64) sum=ef758ae7c6cf9267c9c0ef080b8965f453d89ab2d25d9eb22de4405925238768 ;; \
      amd64) sum=1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f ;; \
      *) echo "no Go release pinned for $GO_ARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/go.tar.gz "https://go.dev/dl/go1.26.4.linux-$GO_ARCH.tar.gz" \
 && echo "$sum  /tmp/go.tar.gz" | sha256sum -c - \
 && tar -C /usr/local -xzf /tmp/go.tar.gz \
 && rm /tmp/go.tar.gz

COPY gperl /opt/gperl/bin/gperl
RUN sh /opt/cpancompat/user.sh \
 && mkdir -p /opt/gperl/mod /opt/go-cache /opt/go-src /bin-out /app \
 && chown cpan:cpan /opt/gperl/mod /opt/go-cache /opt/go-src /bin-out /app
COPY static.sh load.pl gperl.json /opt/cpancompat/

ENV USER=cpan LOGNAME=cpan HOME=/home/cpan SHELL=/bin/bash LANG=C.UTF-8 \
    PATH=/opt/gperl/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GPERLMODCACHE=/opt/gperl/mod GOCACHE=/opt/go-cache/build GOMODCACHE=/opt/go-cache/mod GOTOOLCHAIN=local \
    CC=gcc CGO_ENABLED=1 GOFLAGS=-ldflags=-extldflags=-static
USER cpan

# A gperl whose `gperl build` cannot resolve go-perl itself builds against
# the source of a released go-perl version instead (cpancompat image -static
# -dev-replace <version>): the module, as the Go proxy serves it, given to
# gperl through GPERL_DEV_REPLACE.
ARG DEV_REPLACE=
RUN if [ -n "$DEV_REPLACE" ]; then \
      GOMODCACHE=/opt/go-src GOFLAGS= go mod download github.com/goccy/go-perl@$DEV_REPLACE; \
    fi
ENV GPERL_DEV_REPLACE=${DEV_REPLACE:+github.com/goccy/go-perl=/opt/go-src/github.com/goccy/go-perl@$DEV_REPLACE}
